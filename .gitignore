# --- runtime scratch -------------------------------------------------------
out/
work/
_dl/
_scratch/
test/
*.f32
*.npy
*.stats.json

# --- local configuration and secrets ---------------------------------------
config/tools.json
.gh-token.txt
*.token

# --- fetched binaries and models (see scripts/fetch_models.py) --------------
# The three WIC JXR helpers are small and have no upstream release to fetch, so
# they are committed: without them the final encode step cannot run at all.
tools/*
!tools/README.md
!tools/jxr-encode-wic.exe
!tools/jxr-inspect.exe
!tools/verify-jxr.exe
models/

# --- python ----------------------------------------------------------------
__pycache__/
*.pyc
.pytest_cache/
.venv/
venv/

# --- pip scratch (created in-tree when pip installs run from the repo root) --
pip-build-tracker-*/
pip-install-*/
pip-unpack-*/
pip-ephem-wheel-cache-*/
